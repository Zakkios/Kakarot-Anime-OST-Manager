<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Kakarot Anime OST Manager</Product>
    <Version>0.1.0</Version>
    <!-- Langue de Strings.resx ; Strings.fr.resx est compilé à part. -->
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Intégré dans l'exécutable : l'application se distribue en un seul fichier. -->
    <None Remove="Data\soundtracks.json" />
    <EmbeddedResource Include="Data\soundtracks.json" LogicalName="KakarotOstManager.Data.soundtracks.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>
