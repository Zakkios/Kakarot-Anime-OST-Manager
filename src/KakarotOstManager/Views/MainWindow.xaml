<Window x:Class="KakarotOstManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:KakarotOstManager.Localization"
        Title="{loc:Loc AppTitle}"
        Height="780" Width="980"
        MinHeight="640" MinWidth="860"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Vue de la liste des bandes-son, regroupée par rubrique. -->
        <CollectionViewSource x:Key="GroupedSoundtracks" Source="{Binding Soundtracks}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="CategoryTitle" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <SolidColorBrush x:Key="SuccessBrush" Color="#2E9E4F" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#D9453B" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>

        <!-- Texte d'erreur : il disparaît complètement quand il est vide. -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- En-tête : titre et choix de la langue -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <ComboBox DockPanel.Dock="Right"
                      Width="130" VerticalAlignment="Center"
                      ItemsSource="{Binding Languages}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedLanguage}"
                      IsEnabled="{Binding IsIdle}"
                      ToolTip="{loc:Loc LanguageLabel}"
                      AutomationProperties.Name="{loc:Loc LanguageLabel}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <TextBlock Text="KAKAROT ANIME OST MANAGER"
                       FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Réglages : dossier du jeu, dossier du pack, version -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                       Text="{loc:Loc GameFolderLabel}" />
            <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center"
                     AutomationProperties.Name="{loc:Loc GameFolderLabel}"
                     Text="{Binding GamePath, Mode=OneWay}" />
            <Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Padding="16,6" MinWidth="110"
                    Content="{loc:Loc Browse}" Command="{Binding BrowseGameFolderCommand}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}"
                       Text="{Binding GamePathError}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,12,16,0"
                       Text="{loc:Loc PackFolderLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,12,0,0"
                     AutomationProperties.Name="{loc:Loc PackFolderLabel}"
                     Text="{Binding SoundtrackPath, Mode=OneWay}" />
            <Button Grid.Row="2" Grid.Column="2" Margin="8,12,0,0" Padding="16,6" MinWidth="110"
                    Content="{loc:Loc Browse}" Command="{Binding BrowseSoundtrackFolderCommand}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}"
                       Text="{Binding SoundtrackPathError}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,12,16,0"
                       Text="{loc:Loc GameVersionLabel}" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0"
                        IsEnabled="{Binding IsIdle}">
                <RadioButton GroupName="GameVersion" VerticalAlignment="Center" Margin="0,0,24,0"
                             Content="{loc:Loc VersionStandard}" IsChecked="{Binding IsStandard}" />
                <RadioButton GroupName="GameVersion" VerticalAlignment="Center"
                             Content="{loc:Loc VersionRemaster}" IsChecked="{Binding IsRemaster}" />
            </StackPanel>
        </Grid>

        <!-- Zone principale : liste à gauche, détail à droite -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6"
                           Text="{loc:Loc SoundtracksHeader}" />
                <ListBox ItemsSource="{Binding Source={StaticResource GroupedSoundtracks}}"
                         SelectedItem="{Binding SelectedSoundtrack}"
                         IsEnabled="{Binding IsIdle}">
                    <ListBox.ItemContainerStyle>
                        <!-- Lignes plus compactes que celles du thème, pour voir toute l'histoire sans défiler. -->
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,5" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Margin" Value="2,1" />
                            <!-- Nom lu par les lecteurs d'écran ; sans lui, ils liraient le nom de la classe C#. -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <!-- « Name » est ici le titre du groupe, fourni par WPF. -->
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Opacity="0.7"
                                               Margin="8,12,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Margin="10,0,0,0" FontWeight="SemiBold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="●" />
                                    <Run Text="{loc:Loc InstalledBadge}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1" Margin="28,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Détail de la bande-son sélectionnée -->
                <StackPanel Grid.Row="0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SelectedTitle}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Loc WhenToActivate}" />
                    <TextBlock Text="{Binding SelectedHint}" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Loc FolderLabel}" />
                    <TextBlock Text="{Binding SelectedFolder}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="0" Opacity="0.7" Text="{loc:Loc SelectSoundtrackPrompt}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Bande-son en place et actions -->
                <StackPanel Grid.Row="1">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="{loc:Loc InstalledLabel}" />
                    <TextBlock Text="{Binding InstalledTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Padding="28,10" MinWidth="160" FontWeight="Bold" IsDefault="True"
                                Content="{loc:Loc Apply}" Command="{Binding ApplyCommand}" />
                        <Button Padding="18,10" Margin="12,0,0,0"
                                Content="{loc:Loc RestoreOriginal}" Command="{Binding RestoreCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- État : message, avancement, contrôles effectués -->
        <StackPanel Grid.Row="3" Margin="0,20,0,0" MinHeight="64">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="14">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Success">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Error">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Margin="0,8,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Height="8" Minimum="0" Maximum="1"
                             Value="{Binding ProgressFraction, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}" />
                <TextBlock Text="{Binding ProgressText}" Opacity="0.7" Margin="0,4,0,0" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Checks}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,2">
                            <TextBlock x:Name="Mark" Text="✓" FontWeight="Bold" Margin="0,0,5,0"
                                       Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{Binding Label}" Opacity="0.85" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Passed}" Value="False">
                                <Setter TargetName="Mark" Property="Text" Value="✗" />
                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
